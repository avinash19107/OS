
#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main(void) {
    pid_t pid;

    printf("Before fork(): PID = %d, PPID = %d\n",
           (int)getpid(), (int)getppid());
    fflush(stdout);

    pid = fork();

    if (pid < 0) {
        perror("fork failed");
        return 1;
    } else if (pid == 0) {
        printf("\nChild Process\n");
        printf("Child PID  : %d\n", (int)getpid());
        printf("Parent PID : %d\n", (int)getppid());
    } else {
        printf("\nParent Process\n");
        printf("Parent PID : %d\n", (int)getpid());
        printf("Child PID  : %d\n", (int)pid);
        wait(NULL);
    }

    return 0;
}
