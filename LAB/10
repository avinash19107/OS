
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>
#include <unistd.h>

struct message {
    long msg_type;
    char msg_text[100];
};

int main() {
    int msgid;
    struct message msg;

    msgid = msgget(IPC_PRIVATE, IPC_CREAT | 0666);

    if (msgid == -1) {
        perror("Message queue creation failed");
        return 1;
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        msgctl(msgid, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        msg.msg_type = 1;
        strcpy(msg.msg_text, "Hello from Child Process!");

        printf("Child Process: Sending message...\n");

        if (msgsnd(msgid, &msg,
                   sizeof(msg.msg_text), 0) == -1) {
            perror("Message sending failed");
            exit(1);
        }
    } else {
        wait(NULL);

        printf("Parent Process: Receiving message...\n");

        if (msgrcv(msgid, &msg,
                   sizeof(msg.msg_text), 1, 0) == -1) {
            perror("Message receiving failed");
            msgctl(msgid, IPC_RMID, NULL);
            return 1;
        }

        printf("Received Message: %s\n", msg.msg_text);

        msgctl(msgid, IPC_RMID, NULL);
    }

    return 0;
}
