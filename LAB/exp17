
#include <stdio.h>

int main() {
    int n, m, i, j, k;
    int alloc[10][10], max[10][10];
    int need[10][10], avail[10];
    int finish[10], safe[10];
    int count = 0, found;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter number of resources: ");
    scanf("%d", &m);

    if (n <= 0 || n > 10 || m <= 0 || m > 10) {
        printf("Invalid input.\n");
        return 1;
    }

    printf("\nEnter Allocation Matrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            scanf("%d", &alloc[i][j]);
        }
    }

    printf("\nEnter Maximum Matrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            scanf("%d", &max[i][j]);

            if (max[i][j] < alloc[i][j]) {
                printf("Invalid resource allocation.\n");
                return 1;
            }

            need[i][j] = max[i][j] - alloc[i][j];
        }
    }

    printf("\nEnter Available Resources:\n");
    for (j = 0; j < m; j++) {
        scanf("%d", &avail[j]);
        if (avail[j] < 0) {
            printf("Invalid available resources.\n");
            return 1;
        }
    }

    for (i = 0; i < n; i++) {
        finish[i] = 0;
    }

    printf("\nNeed Matrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            printf("%d ", need[i][j]);
        }
        printf("\n");
    }

    while (count < n) {
        found = 0;

        for (i = 0; i < n; i++) {
            if (finish[i] == 0) {
                int possible = 1;

                for (j = 0; j < m; j++) {
                    if (need[i][j] > avail[j]) {
                        possible = 0;
                        break;
                    }
                }

                if (possible) {
                    for (k = 0; k < m; k++) {
                        avail[k] += alloc[i][k];
                    }

                    safe[count] = i;
                    count++;
                    finish[i] = 1;
                    found = 1;
                }
            }
        }

        if (found == 0) {
            break;
        }
    }

    if (count == n) {
        printf("\nSystem is in SAFE state.\n");
        printf("Safe Sequence: ");

        for (i = 0; i < n; i++) {
            printf("P%d", safe[i]);

            if (i != n - 1)
                printf(" -> ");
        }

        printf("\n");
    } else {
        printf("\nSystem is in UNSAFE state.\n");
        printf("Safe sequence does not exist.\n");
    }

    return 0;
}
