#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd, flags;
    char buffer[100];
    struct stat fileInfo;
    DIR *dir;
    struct dirent *entry;
    ssize_t n;

    /* Create and write to a file */
    fd = open("sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if (fd < 0)
    {
        perror("File opening failed");
        return 1;
    }

    write(fd, "UNIX System Calls", 17);

    /* Demonstrate fcntl() */
    flags = fcntl(fd, F_GETFL);
    printf("File status flags: %d\n", flags);

    /* Demonstrate lseek() */
    lseek(fd, 0, SEEK_SET);

    n = read(fd, buffer, sizeof(buffer) - 1);
    if (n >= 0)
    {
        buffer[n] = '\0';
        printf("File contents: %s\n", buffer);
    }

    close(fd);

    /* Demonstrate stat() */
    if (stat("sample.txt", &fileInfo) == 0)
    {
        printf("File size: %ld bytes\n",
               (long)fileInfo.st_size);
        printf("File permissions: %o\n",
               (unsigned int)(fileInfo.st_mode & 0777));
    }

    /* Demonstrate opendir() and readdir() */
    dir = opendir(".");

    if (dir == NULL)
    {
        perror("Directory opening failed");
        return 1;
    }

    printf("\nFiles in current directory:\n");

    while ((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}
