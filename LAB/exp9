
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main() {
    int shmid;
    char *shared_memory;

    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0666);

    if (shmid == -1) {
        perror("Shared memory creation failed");
        return 1;
    }

    shared_memory = (char *)shmat(shmid, NULL, 0);

    if (shared_memory == (char *)-1) {
        perror("Shared memory attachment failed");
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        shmdt(shared_memory);
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        printf("Child Process: Writing data...\n");
        strcpy(shared_memory, "Hello from Child Process!");
    } else {
        wait(NULL);

        printf("Parent Process: Reading data...\n");
        printf("Data received: %s\n", shared_memory);

        shmdt(shared_memory);
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}
